{
    "name": "scout-and-steward-portal",
    "main": "src/index.js",
    "compatibility_date": "2026-08-08",
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "scout-and-steward-portal",
            "database_id": "195035f9-1d3e-488e-9a07-1da7d942cd54"
        }
    ],
    "observability": {
        "enabled": true
    },
    "secrets": {
        "required": [
            "PUBLISH_TOKEN",
            "EBAY_CLIENT_ID",
            "EBAY_CLIENT_SECRET"
        ]
    }
}
